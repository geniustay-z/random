[Unit]
Description=cc虾 飞书智能助手
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cc-xia
ExecStart=/bin/bash /opt/cc-xia/bot.sh
Restart=always
RestartSec=10
EnvironmentFile=/opt/cc-xia/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
